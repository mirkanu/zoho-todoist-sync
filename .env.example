# Zoho OAuth (EU region)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_USER_ID=your-zoho-user-id
ZOHO_REGION=eu
ZOHO_TODOIST_TASK_ID_FIELD=
ZOHO_TERMINAL_STATUSES=Completed
ZOHO_JOB_DEFER_SECS=2

# Todoist
TODOIST_API_TOKEN=your-todoist-api-token
TODOIST_PROJECT_ID=6gCPcWwM392GhXQh
TODOIST_CLIENT_SECRET=your-todoist-client-secret

# Resend
RESEND_API_KEY=your-resend-api-key

# Infrastructure
# Local dev defaults (docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/zoho_sync
REDIS_URL=redis://redis:6379

# App
LOG_LEVEL=INFO
